# Copy this file to /etc/starlink-heartbeat.env (mode 600) on the gateway
# and fill in the real values. Read by heartbeat.sh AND watchdog.sh -- both
# `source` the same file (see STARLINK_HB_CONFIG in either script if this
# needs to live somewhere else). NOT committed to git once filled in.
# Same fields as the Windows path's config.template.env -- both platforms
# speak the same wire protocol.

# The VPS's public heartbeat endpoint, e.g. https://api.setalink.no/starlink-heartbeat.php
VPS_API_URL=

# Fixed for Phase 1's single test node -- do not change without also updating
# the node_id in the admin panel's Starlink tab.
NODE_ID=starlink-no-01

# Paste the full "starlink-node-<id>:<secret>" string shown ONCE by the
# admin panel's "Generate heartbeat token" button for starlink-no-01.
HEARTBEAT_TOKEN=

# WireGuard interface name -- must match what setup-raspberrypi.sh/enroll.sh
# actually created (wg-starlink0 on both scripts today).
WG_IFACE=wg-starlink0

# The interface facing the Starlink router (Wi-Fi client or Ethernet to the
# Starlink Mini) -- watchdog.sh's NAT/forwarding assert and the WAN-up
# backoff check both key off this. Must match the value passed to
# setup-raspberrypi.sh's [wan-iface] argument.
WAN_IFACE=wlan0

# Handshake older than this = tunnel considered dead (watchdog.sh duty 1).
# 180s matches the Windows watchdog's default; change only with a reason.
HANDSHAKE_STALE_SECS=180
