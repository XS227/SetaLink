# Copy this file to gateway.env (same folder) and fill in the real values.
# gateway.env is read by heartbeat.ps1 — it is NOT committed to git (matches
# the existing pattern for the Linux gateway's /etc/starlink-heartbeat.env).
# Never put the real HEARTBEAT_TOKEN or any private key in this template file.

# The VPS's public heartbeat endpoint, e.g. https://api.setalink.no/starlink-heartbeat.php
VPS_API_URL=

# Fixed for Phase 1's single test node — do not change without also updating
# the node_id in the admin panel's Starlink tab.
NODE_ID=starlink-no-01

# Display name shown in the admin panel (cosmetic only).
DISPLAY_NAME=Norway Starlink #01

# node_type=STARLINK, role=EXIT_ONLY are fixed by lib/starlink.php's schema —
# not configurable per-gateway, listed here only for documentation.
# NODE_TYPE=STARLINK
# ROLE=EXIT_ONLY

# Paste the full "starlink-node-<id>:<secret>" string shown ONCE by the
# admin panel's "Generate heartbeat token" button for starlink-no-01.
HEARTBEAT_TOKEN=
