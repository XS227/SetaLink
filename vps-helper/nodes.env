# ReaLink exit-node registry for the VPS Helper (PUBLIC Reality params only —
# never private keys). Consumed by provision.sh. Client entry point is the
# node's :443 (nginx SNI-preread → xray Reality), address = node public IP.
#
# EXIT = node public egress IP (what api.ipify.org returns through the tunnel),
# used by the installer to verify traffic actually leaves via the node.

# Finland / Helsinki (hel1) — hand-rolled xray + nginx SNI-stream.
# WORKS from Iran (primary for Iranian VPS). flow = xtls-rprx-vision.
FINLAND_SSH=root@65.109.183.7
FINLAND_ADDRESS=65.109.183.7
FINLAND_PORT=443
FINLAND_PBK=eGL5TwzXjS4_kQrqAGBrY2K6MqjRXmz70xYhcgXUXwU
FINLAND_SID=b3a824bd
FINLAND_SNI=www.cloudflare.com
FINLAND_FLOW=xtls-rprx-vision
FINLAND_FP=chrome
FINLAND_EXIT=65.109.183.7
FINLAND_CONFIG=/usr/local/etc/xray/config.json
FINLAND_INBOUND_TAG=inbound-reality
FINLAND_RESTART="systemctl restart xray"

# Germany / Nuremberg (nbg1) — x-ui/3x-ui, Reality flow="" direct on :443.
# NOTE: largely BLOCKED from Iran (Hetzner-DE) — use only for non-Iran VPS or
# failover. flow is empty. Provisioning path differs (x-ui panel/DB), so this
# node is registered for reference; provision.sh currently automates Finland.
GERMANY_SSH=root@178.104.77.231
GERMANY_ADDRESS=178.104.77.231
GERMANY_PORT=443
GERMANY_PBK=IJXsDOA55gNiMZprjOdfaS6pN9ifm4MSqlsiZDGzki8
GERMANY_SID=d93af82f2ecb7f6a
GERMANY_SNI=www.cloudflare.com
GERMANY_FLOW=
GERMANY_FP=chrome
GERMANY_EXIT=178.104.77.231
